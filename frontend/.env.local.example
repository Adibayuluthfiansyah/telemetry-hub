# Telemetry Hub Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# WebSocket Server URL (default: ws://localhost:3000/api/v1/stream)
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/stream

# API Base URL (REST history seed for trend charts; defaults to WS URL with ws->http and /stream stripped)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1